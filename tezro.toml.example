# SGI Tezro (IP53 board, IP35 software platform), serial-only setup.
# Copy to tezro.toml and run from the repository root: iris --config tezro.toml
# Create ignore/tezro/ and supply your decoded raw IP35 PROM 6.210 payload
# and an IRIX disk installed on a Tezro: a disk installed on another machine
# carries that machine's device numbering.
# No PROM or disk images are included. Convert QCOW2 disks to raw first.

prom = "ignore/tezro/ip35prom.payload.bin"
nvram = "ignore/tezro/nvram.bin"
# banks left unset: 4 GiB as 1024, 1024 and four 512 MiB banks.
headless = true
no_audio = true
monitor_port = 18888
serial_port_a = 18880
serial_port_b = 18881

[machine]
profile = "tezro"
# Required: names the R10000 family. The machine always runs the
# R16000 at 700 MHz with a 4 MiB secondary cache; other values are refused.
cpu = "r10000"

[graphics]
board = "none"

[tezro]
# Processors fitted: 1, 2 or 4 (the default). Only CPU 0 runs.
cpus = 4
flash = "ignore/tezro/flash.bin"
console = "l1"
l1_port = 18882

[network]
# Disconnected cable. For NAT, use mode = "nat".
mode = "off"

[scsi.1]
path = "ignore/tezro/irix.raw"
cdrom = false
# Keep the base disk unchanged. Guest writes go to irix.raw.overlay.
overlay = true
