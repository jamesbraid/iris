sgi-replay 2
head sgi-mgras
# Synthetic fill through the MGRAS command FIFO. Scanout resolves every
# pixel through the colour map its WID's XMAP mode selects, so the fill is
# painted where the VC3 main display-ID table names WID 5 and a palette
# entry is loaded.
write 1 0x073c08 0x55
read 1 0x073c08 0x55
write 4 0x072038 0x06246800
write 1 0x072008 0x06
read 2 0x0720b0 0x2468
read 4 0x008000 0x0
write 4 0x011000 0x0
write 4 0x130500 0x000004fc
read 4 0x011020 0x00080000
write 4 0x011028 0x00080000
read 4 0x011020 0x0
write 4 0x120400 0x5420
write 4 0x120400 0xc000000
write 4 0x120400 0x33c0060
write 4 0x120400 0x11
write 4 0x120400 0x0
write 4 0x120400 0x7be000
write 4 0x120400 0x1beffc
write 4 0x120400 0xa8000000
write 4 0x120400 0xc0000000
write 4 0x120400 0xf120000
write 4 0x120400 0x146d080
write 4 0x120400 0x6000c3
write 4 0x120400 0x33c039f
write 4 0x120400 0x90240
write 4 0x120400 0x33c0060
write 4 0x120400 0x90240
write 4 0x120400 0x1
write 4 0x120400 0x1
write 4 0x120400 0x5500ab
write 4 0x120400 0x6600ba
write 4 0x120400 0x100012
write 4 0x120400 0x10400008
write 4 0x120400 0x11
write 4 0x120400 0xff0
write 4 0x120400 0xcac
write 4 0x120400 0xc004504
write 4 0x120400 0x0
write 4 0x120400 0xff
write 4 0x120400 0xff
write 4 0x120400 0x11
write 4 0x120400 0xc10
write 4 0x120400 0xc10
write 4 0x120400 0x0
write 4 0x120400 0x0
write 4 0x120400 0x0
write 4 0x120400 0x0
write 4 0x120400 0x4ff
write 4 0x120400 0x3ff
write 4 0x120400 0xffffff
write 4 0x120400 0xffffff
write 4 0x120400 0x0
write 4 0x120400 0x0
write 4 0x120400 0x0
write 4 0x120400 0x0
write 4 0x120400 0x0
write 4 0x120400 0x0
write 4 0x120400 0x0
